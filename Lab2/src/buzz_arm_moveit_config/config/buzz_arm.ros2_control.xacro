<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
      ros2_control description for the buzz_arm. The Setup Assistant generated
      this file; the comments were added afterwards.

      A <ros2_control> block answers two questions for controller_manager:
        * WHICH joints exist and what each one exposes
            command_interface = what a controller is allowed to write
            state_interface   = what the hardware reports back
        * WHO drives them  (the <hardware><plugin> line)

      The joint list would be identical for a real driver. Only the
      <hardware> block changes. That separation is the whole point of
      ros2_control: controllers (JointTrajectoryController etc.) never know
      what is behind the interfaces they read and write.
    -->
    <xacro:macro name="buzz_arm_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions"
                        value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- Built into ros2_control. Every write() is copied straight
                     into the state interfaces, so the arm "teleports" to each
                     commanded position. No robot on the desk needed. -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>

            <!-- One block per actuated joint. Mimic_LFinger is NOT listed: it is
                 a <mimic> of Revolute_RFinger in the URDF and has no servo. -->
            <joint name="Revolute_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Revolute_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Revolute_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Revolute_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Revolute_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Revolute_RFinger">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Revolute_RFinger']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
