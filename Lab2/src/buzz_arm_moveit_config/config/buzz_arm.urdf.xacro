<?xml version="1.0"?>
<!--
  Top-level xacro that MoveIt actually loads.

  It does two things:
    1. Includes the plain URDF from buzz_arm_description (links, joints, meshes).
    2. Appends a <ros2_control> block so controller_manager knows which joints
       exist and which hardware plugin drives them.

  Resolve it by hand to see exactly what MoveIt sees:
    xacro buzz_arm.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="buzz_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import buzz_arm urdf file -->
    <xacro:include filename="$(find buzz_arm_description)/urdf/buzz_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="buzz_arm.ros2_control.xacro" />

    <xacro:buzz_arm_ros2_control
        name="buzz_arm_system"
        initial_positions_file="$(arg initial_positions_file)" />

</robot>
